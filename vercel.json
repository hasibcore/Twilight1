{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/landing/index.html" },
    { "source": "/downloads/:path*", "destination": "/landing/downloads/:path*" },
    { "source": "/styles.css", "destination": "/landing/styles.css" },
    { "source": "/app.js", "destination": "/landing/app.js" },
    { "source": "/((?!landing).*|$)", "destination": "/landing/$1" }
  ],
  "headers": [
    {
      "source": "/downloads/(.*)",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
